# Copy this file to .env and adjust as needed:  cp .env.example .env
# Everything here is optional: the defaults below are what you get without a .env.

# --- Backend (NestJS) ---
BACKEND_PORT=3000

# Where the emulator keeps everything (chargers, cars, sessions, logs).
# One SQLite file; inside Docker it lives on the "ocpp_data" volume.
SQLITE_PATH=data/emulator.sqlite

# --- UI (Vite) ---
UI_PORT=5173

# The browser talks only to the UI server (/api, /socket.io), which forwards to
# this address. Default: http://localhost:$BACKEND_PORT. docker-compose sets it
# to http://backend:3000.
# BACKEND_URL=http://localhost:3000

# Host names the UI may be opened by (comma list). Unset = any.
# ALLOWED_HOSTS=emulator.example.com

# Only for a static build served without the Vite server: the backend address
# the browser should call directly. Baked in at build time.
# VITE_API_URL=http://my-host:3000/api
# VITE_WS_URL=http://my-host:3000

# --- Auth (JWT) ---
# Only used once somebody locks the instance from the UI. Change the secret
# before you expose the emulator to anyone else.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
